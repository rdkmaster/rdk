   /*测试构造函数CombinedDataSource*/
    describe('-> test the constructor of the CombinedDataSource', function() {
        /*定义ds存放DataSource实例，通过这个实例访问DataSource对外提供的接口*/
        var ds;
        beforeEach(function(){
            var id = 13, dataSources = ['combinedPie', 'combinedrectangular'], handlers = {};
			handlers.conditionProcessor = function(condition) {
				return 'conditionProcessor:' + condition;
			};
			handlers.dataProcessor = function(data) {
				return 'dataProcessor:' + data;
			};
			
            spyOn(dataSourceService, 'createCombined').and.callThrough();
            ds = dataSourceService.create(id, dataSources, handlers);
        });

        /*测试CombinedDataSource里的对外接口bind函数*/
        it('-> test the function of bind in the CombinedDataSource', function() {
            var scope, eventType, ds_inner;
            spyOn(ds, 'bind').and.callThrough();
            ds_inner = ds.bind(scope, eventType);
		
            expect(ds_inner.id).toBe(13);
			expect(ds_inner.type).toBe('combined');
        });

        /*测试DataSource里的对外接口processData函数*/
        xit('-> test the function of processData in the CombinedDataSource', function() {
            var rawData;
            spyOn(ds, 'processData').and.callThrough();
            ds.processData(rawData);

            expect(ds.processData).toHaveBeenCalled();
        });

        /*测试DataSource里的对外接口query函数*/
		/*busy属性默认为fasle*/
        it('-> test the function of query in the CombinedDataSource', function() {
            var condition, val;
            spyOn(ds, 'query').and.callThrough();
            val = ds.query(condition);
			
			expect(ds.busy).toBe(true);
			expect(val).toBeUndefined();
        });
		/*手动将busy属性修改为true*/
        it('-> test the function of query in the CombinedDataSource', function() {
            var condition, val;
			ds.busy = true;
            spyOn(ds, 'query').and.callThrough();
            val = ds.query(condition);
			
			expect(ds.busy).toBe(true);
			expect(val).toBeUndefined();
        });
		/*conditionProcessor为undefined*/
        it('-> test the function of query in the CombinedDataSource', function() {
            var condition, val;
			ds.conditionProcessor = undefined;
            spyOn(ds, 'query').and.callThrough();
            val = ds.query(condition);
			
			expect(ds.busy).toBe(true);
			expect(val).toBeUndefined();
        });		

    });
	
	/*测试构造函数CombinedDataSource：registerEvents和processData*/
	describe('->test the constructor of the CombinedDataSource: registerEvents and processData', function() {
		var ds_combined, eventType, val;
		
		beforeEach(function() {
			var id = 14, dataSources = ['/demo/combinedPie', ['/demo/combinedRectangular', '/demo/combined']], handlers = {};
			
			handlers.conditionProcessor = function(condition) {
				return 'conditionProcessor:' + condition;
			};
			handlers.dataProcessor = function(data) {
				return 'dataProcessor:' + data;
			};	
			
			spyOn(dataSourceService, 'create').and.callThrough();
            ds_combined = dataSourceService.create(id, dataSources, handlers);
		});
		
		/*测试DataSource里的对外接口registerEvents函数*/
		it('-> test the function of registerEvents ', function() {
			ds_combined.registerEvents(eventType);
			
			expect(ds_combined.id).toBe(14);
			expect(ds_combined.list[0].id).toBe('ds0');
			expect(ds_combined.list[0].url).toBe('/demo/combinedPie');
			expect(ds_combined.list[1].list.length).toBe(2);
			expect(ds_combined.list[1].type).toBe('combined');
			expect(ds_combined.list[1].list[0].id).toBe('ds2');
			expect(ds_combined.list[1].list[0].url).toBe('/demo/combinedRectangular');
			
		});
		
		
		/*测试DataSource里的对外接口processData函数*/
		xit('-> test the function of registerEvents ', function() {
			var val, rawData = {
				'ds0': 'beijing',
				'ds1': {
					'ds2': 'nanjing',
					'ds3': 'suzhou'
				}
			};
			
			val = ds_combined.processData(rawData);
			
		});
		/*测试DataSource里的对外接口processData函数*/
		it('-> test the function of registerEvents ', function() {
			var val, rawData = {
				'ds0': 'beijing',
				'ds10': 'nanjing'
			};
			
			val = ds_combined.processData(rawData);
			
		});
		/*dataProcessor为undefined*/
		it('-> test the function of registerEvents ', function() {
			var rawData = 'nanjing', val;
			
			ds_combined.dataProcessor = undefined;		
			val = ds_combined.processData(rawData);
			
			expect(val).toBe('nanjing');
		});
	});
	
